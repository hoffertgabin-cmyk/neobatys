# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.neobatys.com

# Envoi des demandes de contact via Resend (https://resend.com)
# Sans ces deux variables, les demandes sont seulement affichées dans les logs du serveur.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Copie de chaque demande de contact dans le CRM de l'outil d'administration (POST /api/leads)
# En ligne : ADMIN_LEADS_URL=https://admin.neobatys.com/api/leads
# ADMIN_LEADS_SECRET doit être identique à LEADS_SECRET dans le projet Vercel de l'admin.
# Clé secrète, côté serveur uniquement : jamais de préfixe NEXT_PUBLIC_. Sans ces deux variables, rien n'est envoyé.
ADMIN_LEADS_URL=
ADMIN_LEADS_SECRET=

# Assistant IA de la FAQ (https://console.anthropic.com → API Keys)
# Clé secrète, lue uniquement côté serveur : ne jamais la préfixer par NEXT_PUBLIC_.
# Sans cette variable, le champ reste affiché mais renvoie vers la page contact.
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif). Par défaut : claude-opus-5-5
FAQ_ASSISTANT_MODEL=

# Expéditeur (domaine à vérifier dans Resend). Par défaut : onboarding@resend.dev
CONTACT_FROM_EMAIL="NEOBATYS <contact@neobatys.com>"
