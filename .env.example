# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.neobatys.fr

# Envoi des demandes de contact via Resend (https://resend.com)
# Sans ces deux variables, les demandes sont seulement affichées dans les logs du serveur.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Expéditeur (domaine à vérifier dans Resend). Par défaut : onboarding@resend.dev
CONTACT_FROM_EMAIL="NEOBATYS <contact@neobatys.fr>"
